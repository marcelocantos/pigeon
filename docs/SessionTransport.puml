@startuml transport
!theme plain
skinparam backgroundColor white
skinparam state {
  BackgroundColor #f8f8f8
  BorderColor #888
}

title Session — Transport

state "backend" as B {
  state "Pairing" as B_Pairing {
    [*] --> B_Idle
    B_Idle --> B_GenerateToken : cli_init_pair\ngenerate_token
    B_GenerateToken --> B_RegisterRelay : token_created\nregister_relay
    B_RegisterRelay --> B_WaitingForClient : relay_registered
    B_WaitingForClient --> B_DeriveSecret : recv pair_hello\n[token_valid]\nderive_secret
    B_WaitingForClient --> B_Idle : recv pair_hello\n[token_invalid]
    B_DeriveSecret --> B_SendAck : ecdh_complete
    B_SendAck --> B_WaitingForCode : signal_code_display
    B_WaitingForCode --> B_ValidateCode : cli_code_entered
    B_ValidateCode --> B_StorePaired : check_code\n[code_correct]
    B_ValidateCode --> B_Idle : check_code\n[code_wrong]
    B_StorePaired --> B_Paired : finalise\nstore_device
    B_Paired --> B_AuthCheck : recv auth_request
    B_AuthCheck --> B_SessionActive : verify\n[device_known]\nverify_device
    B_AuthCheck --> B_Idle : verify\n[device_unknown]
  }

  state "Transport" as B_Transport {
    [*] --> B_RelayConnected
    B_RelayConnected --> B_CandidatesAdvertised : candidates_gathered
    B_CandidatesAdvertised --> B_AltActive : recv pair_check\n[challenge_valid]\nactivate_lan
    B_CandidatesAdvertised --> B_RelayConnected : recv pair_check\n[challenge_invalid]
    B_CandidatesAdvertised --> B_RelayBackoff : candidates_timeout
    B_AltActive --> B_AltActive : ping_tick\napp_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram\nalt_stream_data\nalt_datagram
    B_AltActive --> B_AltDegraded : ping_timeout
    B_AltDegraded --> B_AltDegraded : ping_tick\napp_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram\nalt_stream_data\nalt_datagram
    B_AltActive --> B_RelayBackoff : alt_stream_error\napp_force_fallback\nfallback_to_relay
    B_AltDegraded --> B_RelayBackoff : alt_stream_error\napp_force_fallback\nfallback_to_relay
    B_AltDegraded --> B_AltActive : recv path_pong\nreset_failures
    B_AltDegraded --> B_AltDegraded : ping_timeout\n[under_max_failures]
    B_AltDegraded --> B_RelayBackoff : ping_timeout\n[at_max_failures]\nfallback_to_relay
    B_RelayBackoff -[bold]-> B_CandidatesAdvertised : backoff_expired\n«SF»
    B_RelayBackoff --> B_CandidatesAdvertised : candidates_changed
    B_RelayConnected --> B_CandidatesAdvertised : candidates_refresh_tick\n[local_candidates_available]
    B_CandidatesAdvertised --> B_RelayConnected : app_force_fallback
    B_RelayConnected --> B_RelayConnected : app_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram
    B_CandidatesAdvertised --> B_CandidatesAdvertised : app_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram
    B_RelayBackoff --> B_RelayBackoff : app_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram
  }

  B_SessionActive --> B_RelayConnected : session_established
  B_RelayConnected --> B_Paired : disconnect
}

state "client" as C {
  state "Pairing" as C_Pairing {
    [*] --> C_Idle
    C_Idle --> C_ObtainBackchannelSecret : backchannel_received
    C_ObtainBackchannelSecret --> C_ConnectRelay : secret_parsed
    C_ConnectRelay --> C_GenKeyPair : relay_connected
    C_GenKeyPair --> C_WaitAck : key_pair_generated\nsend_pair_hello
    C_WaitAck --> C_E2EReady : recv pair_hello_ack\nderive_secret
    C_E2EReady --> C_ShowCode : recv pair_confirm
    C_ShowCode --> C_WaitPairComplete : code_displayed
    C_WaitPairComplete --> C_Paired : recv pair_complete\nstore_secret
    C_Paired --> C_Reconnect : app_launch
    C_Reconnect --> C_SendAuth : relay_connected
    C_SendAuth --> C_SessionActive : recv auth_ok
  }

  state "Transport" as C_Transport {
    [*] --> C_RelayConnected
    C_RelayConnected --> C_PairDialing : recv candidates\n[alt_enabled]\ndial_candidate
    C_RelayConnected --> C_RelayConnected : recv candidates\n[alt_disabled]
    C_PairDialing --> C_PairChecking : dial_ok
    C_PairDialing --> C_RelayConnected : dial_failed\napp_force_fallback
    C_PairChecking --> C_AltActive : recv pair_check_ack\nactivate_lan
    C_PairChecking --> C_RelayConnected : verify_timeout\napp_force_fallback
    C_AltActive --> C_AltActive : recv path_ping\napp_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram\nalt_stream_data\nalt_datagram
    C_AltActive --> C_RelayFallback : alt_error\nalt_stream_error\nfallback_to_relay
    C_RelayFallback --> C_RelayConnected : relay_ok
    C_AltActive --> C_PairDialing : recv candidates\n[alt_enabled]\ndial_candidate
    C_AltActive --> C_RelayConnected : app_force_fallback\nfallback_to_relay
    C_RelayConnected --> C_RelayConnected : app_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram
    C_PairDialing --> C_PairDialing : app_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram
    C_PairChecking --> C_PairChecking : app_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram
    C_RelayFallback --> C_RelayFallback : app_send\nrelay_stream_data\nrelay_stream_error\napp_send_datagram\nrelay_datagram
  }

  C_SessionActive --> C_RelayConnected : session_established
  C_RelayConnected --> C_Paired : disconnect
}

' === Cross-actor interactions ===

B_DeriveSecret -[#888,dashed]-> C_WaitAck : pair_hello_ack\n{pubkey}
B_SendAck -[#888,dashed]-> C_E2EReady : pair_confirm
B_StorePaired -[#888,dashed]-> C_WaitPairComplete : pair_complete\n{key, secret}
B_AuthCheck -[#888,dashed]-> C_SendAuth : auth_ok
B_RelayConnected -[#888,dashed]-> C_RelayConnected : candidates\n{challenge, set}
B_CandidatesAdvertised -[#888,dashed]-> C_PairChecking : pair_check_ack
B_AltActive -[#888,dashed]-> C_AltActive : path_ping
B_AltDegraded -[#888,dashed]-> C_AltActive : path_ping
B_RelayBackoff -[#888,dashed]-> C_RelayConnected : candidates\n{challenge, set}
B_RelayBackoff -[#888,dashed]-> C_RelayConnected : candidates\n{challenge, set}
B_RelayConnected -[#888,dashed]-> C_RelayConnected : candidates\n{challenge, set}
C_GenKeyPair -[#888,dashed]-> B_WaitingForClient : pair_hello\n{pubkey, token}
C_Reconnect -[#888,dashed]-> B_Paired : auth_request\n{device_id, key, nonce, secret}
C_PairDialing -[#888,dashed]-> B_CandidatesAdvertised : pair_check\n{challenge, instance_id}
C_AltActive -[#888,dashed]-> B_AltDegraded : path_pong

@enduml
